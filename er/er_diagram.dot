digraph ER {
  graph [rankdir=LR, fontname="Helvetica", nodesep=0.5, ranksep=1.3, pad=0.3, bgcolor="white", label=<<b>E-commerce churn: ER-модель та feature store</b><br/><font point-size="11">PK — первинний ключ, FK — зовнішній ключ, NN — NOT NULL, UQ — UNIQUE. Кардинальність min..max: min 0 — зв'язок необов'язковий, min 1 — обов'язковий.</font>>, labelloc=t, fontsize=18];
  node [shape=plain, fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=10, dir=both, color="#333333"];
subgraph cluster_biz {
    label=<<b>Бізнесові сутності (OLTP, 3НФ)</b>>; style="rounded,dashed"; color="#3d6fd6"; fontsize=16;
    "hw2_categories" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td colspan="3" bgcolor="#cfe2ff"><b>hw2_categories</b></td></tr><tr><td align="left"><b>PK</b></td><td align="left"><u>category_id</u></td><td align="left"><font color="#555555">INTEGER</font></td></tr><tr><td align="left"> </td><td align="left">name</td><td align="left"><font color="#555555">VARCHAR(100) UQ NN</font></td></tr></table>>];
    "hw2_products" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td colspan="3" bgcolor="#cfe2ff"><b>hw2_products</b></td></tr><tr><td align="left"><b>PK</b></td><td align="left"><u>product_id</u></td><td align="left"><font color="#555555">BIGINT</font></td></tr><tr><td align="left"><b>FK</b></td><td align="left">category_id</td><td align="left"><font color="#555555">INTEGER NN</font></td></tr><tr><td align="left"> </td><td align="left">name</td><td align="left"><font color="#555555">TEXT NN</font></td></tr><tr><td align="left"> </td><td align="left">list_price</td><td align="left"><font color="#555555">NUMERIC(10,2) NN</font></td></tr><tr><td align="left"> </td><td align="left">is_active</td><td align="left"><font color="#555555">BOOLEAN NN</font></td></tr></table>>];
    "hw2_order_items" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td colspan="3" bgcolor="#e2d9f3"><b>hw2_order_items</b></td></tr><tr><td align="left"><b>PK,FK</b></td><td align="left"><u>order_id</u></td><td align="left"><font color="#555555">BIGINT</font></td></tr><tr><td align="left"><b>PK,FK</b></td><td align="left"><u>product_id</u></td><td align="left"><font color="#555555">BIGINT</font></td></tr><tr><td align="left"> </td><td align="left">quantity</td><td align="left"><font color="#555555">INTEGER NN CHECK &gt; 0</font></td></tr><tr><td align="left"> </td><td align="left">unit_price</td><td align="left"><font color="#555555">NUMERIC(10,2) NN</font></td></tr></table>>];
    "hw2_orders" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td colspan="3" bgcolor="#cfe2ff"><b>hw2_orders</b></td></tr><tr><td align="left"><b>PK</b></td><td align="left"><u>order_id</u></td><td align="left"><font color="#555555">BIGINT</font></td></tr><tr><td align="left"><b>FK</b></td><td align="left">customer_id</td><td align="left"><font color="#555555">BIGINT NN</font></td></tr><tr><td align="left"> </td><td align="left">order_ts</td><td align="left"><font color="#555555">TIMESTAMPTZ NN</font></td></tr><tr><td align="left"> </td><td align="left">status</td><td align="left"><font color="#555555">VARCHAR(20) NN CHECK</font></td></tr></table>>];
    "hw2_customers" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td colspan="3" bgcolor="#cfe2ff"><b>hw2_customers</b></td></tr><tr><td align="left"><b>PK</b></td><td align="left"><u>customer_id</u></td><td align="left"><font color="#555555">BIGINT</font></td></tr><tr><td align="left"> </td><td align="left">email</td><td align="left"><font color="#555555">VARCHAR(255) UQ NN</font></td></tr><tr><td align="left"> </td><td align="left">signup_date</td><td align="left"><font color="#555555">DATE NN</font></td></tr><tr><td align="left"> </td><td align="left">country</td><td align="left"><font color="#555555">VARCHAR(2) NN CHECK</font></td></tr><tr><td align="left"> </td><td align="left">marketing_opt_in</td><td align="left"><font color="#555555">BOOLEAN NN</font></td></tr></table>>];
  }
subgraph cluster_off {
    label=<<b>Offline-рівень feature store (історія, навчання)</b>>; style="rounded,dashed"; color="#c98a00"; fontsize=16;
    "hw2_customer_features_offline" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td colspan="3" bgcolor="#ffe8b3"><b>hw2_customer_features_offline</b></td></tr><tr><td align="left"><b>PK,FK</b></td><td align="left"><u>customer_id</u></td><td align="left"><font color="#555555">BIGINT</font></td></tr><tr><td align="left"><b>PK</b></td><td align="left"><u>valid_from</u></td><td align="left"><font color="#555555">TIMESTAMPTZ</font></td></tr><tr><td align="left"> </td><td align="left">valid_to</td><td align="left"><font color="#555555">TIMESTAMPTZ NULL</font></td></tr><tr><td align="left"> </td><td align="left">orders_30d</td><td align="left"><font color="#555555">INTEGER NN</font></td></tr><tr><td align="left"> </td><td align="left">spend_30d</td><td align="left"><font color="#555555">NUMERIC(12,2) NN</font></td></tr><tr><td align="left"> </td><td align="left">days_since_last_order</td><td align="left"><font color="#555555">INTEGER NULL</font></td></tr><tr><td align="left"> </td><td align="left">distinct_categories_90d</td><td align="left"><font color="#555555">INTEGER NN</font></td></tr></table>>];
    "hw2_training_events" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td colspan="3" bgcolor="#ffe8b3"><b>hw2_training_events</b></td></tr><tr><td align="left"><b>PK</b></td><td align="left"><u>event_id</u></td><td align="left"><font color="#555555">BIGINT IDENTITY</font></td></tr><tr><td align="left"><b>FK</b></td><td align="left">customer_id</td><td align="left"><font color="#555555">BIGINT NN</font></td></tr><tr><td align="left"> </td><td align="left">prediction_ts</td><td align="left"><font color="#555555">TIMESTAMPTZ NN</font></td></tr><tr><td align="left"> </td><td align="left">label_horizon_end</td><td align="left"><font color="#555555">TIMESTAMPTZ NN</font></td></tr><tr><td align="left"> </td><td align="left">churn_in_horizon</td><td align="left"><font color="#555555">BOOLEAN NN (target)</font></td></tr></table>>];
  }
subgraph cluster_on {
    label=<<b>Online-рівень feature store (serving)</b>>; style="rounded,dashed"; color="#2e8b57"; fontsize=16;
    "hw2_customer_features_online" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td colspan="3" bgcolor="#c9ecd4"><b>hw2_customer_features_online</b></td></tr><tr><td align="left"><b>PK,FK</b></td><td align="left"><u>customer_id</u></td><td align="left"><font color="#555555">BIGINT</font></td></tr><tr><td align="left"> </td><td align="left">country</td><td align="left"><font color="#555555">VARCHAR(2) NN (denorm)</font></td></tr><tr><td align="left"> </td><td align="left">signup_date</td><td align="left"><font color="#555555">DATE NN (denorm)</font></td></tr><tr><td align="left"> </td><td align="left">orders_30d</td><td align="left"><font color="#555555">INTEGER NN</font></td></tr><tr><td align="left"> </td><td align="left">spend_30d</td><td align="left"><font color="#555555">NUMERIC(12,2) NN</font></td></tr><tr><td align="left"> </td><td align="left">days_since_last_order</td><td align="left"><font color="#555555">INTEGER NULL</font></td></tr><tr><td align="left"> </td><td align="left">distinct_categories_90d</td><td align="left"><font color="#555555">INTEGER NN</font></td></tr><tr><td align="left"> </td><td align="left">feature_ts</td><td align="left"><font color="#555555">TIMESTAMPTZ NN</font></td></tr><tr><td align="left"> </td><td align="left">updated_at</td><td align="left"><font color="#555555">TIMESTAMPTZ NN</font></td></tr></table>>];
  }
  "hw2_customers" -> "hw2_orders" [arrowtail=teetee, arrowhead=crowodot, label="places", taillabel="1..1", headlabel="0..N", labeldistance=2.2];
  "hw2_orders" -> "hw2_order_items" [arrowtail=teetee, arrowhead=crowtee, label="contains", taillabel="1..1", headlabel="1..N", labeldistance=2.2];
  "hw2_products" -> "hw2_order_items" [arrowtail=teetee, arrowhead=crowodot, label="sold in", taillabel="1..1", headlabel="0..N", labeldistance=2.2];
  "hw2_categories" -> "hw2_products" [arrowtail=teetee, arrowhead=crowodot, label="groups", taillabel="1..1", headlabel="0..N", labeldistance=2.2];
  "hw2_customers" -> "hw2_customer_features_offline" [arrowtail=teetee, arrowhead=crowodot, label="history of", taillabel="1..1", headlabel="0..N", labeldistance=2.2, tailport="s"];
  "hw2_customers" -> "hw2_training_events" [arrowtail=teetee, arrowhead=crowodot, label="labelled at", taillabel="1..1", headlabel="0..N", labeldistance=2.2, tailport="se"];
  "hw2_customers" -> "hw2_customer_features_online" [arrowtail=teetee, arrowhead=teeodot, label="current row", taillabel="1..1", headlabel="0..1", labeldistance=2.2, tailport="sw"];
  "hw2_training_events" -> "hw2_customer_features_offline" [style=dashed, dir=forward, arrowhead=vee, color="#c98a00", fontcolor="#8a5a00", label=<<b>AS-OF JOIN</b> (логічний, без FK):<br/>valid_from &lt;= prediction_ts &lt; valid_to>];
  "hw2_customer_features_offline" -> "hw2_customer_features_online" [style=dashed, dir=forward, arrowhead=vee, color="#2e8b57", fontcolor="#1d5e39", label=<<b>materialize</b>: версія з valid_to IS NULL<br/>(UPSERT за customer_id)>];
}